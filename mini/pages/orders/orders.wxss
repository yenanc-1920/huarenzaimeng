.order-item { padding: 24rpx; }
.order-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #F5F5F5; }
.order-no { font-size: 26rpx; color: #666; }
.order-status { font-size: 26rpx; font-weight: 500; }
.status-SUCCESS { color: #52C41A; }
.status-CHARGING { color: #1890FF; }
.status-PENDING_PAY { color: #FAAD14; }
.status-FAILED { color: #FF4D4F; }
.status-REFUNDED { color: #999; }
.order-body { margin-bottom: 16rpx; }
.order-info { display: flex; justify-content: space-between; padding: 8rpx 0; }
.order-label { font-size: 28rpx; color: #666; }
.order-value { font-size: 28rpx; color: #333; }
.order-value.price { color: #FF4D4F; font-weight: bold; }
.order-footer { text-align: right; }
.order-time { font-size: 24rpx; color: #999; }
.empty { text-align: center; padding: 120rpx 0; color: #999; font-size: 28rpx; }