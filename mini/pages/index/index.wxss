.phone-input {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #eee;
  padding: 20rpx 0;
}
.prefix {
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 16rpx;
  color: #333;
}
.phone-input input {
  flex: 1;
  font-size: 36rpx;
}
.input-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.favorites {
  margin-top: 20rpx;
}
.fav-label {
  font-size: 24rpx;
  color: #999;
}
.fav-list {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}
.fav-item {
  background: #F0F5FF;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #0066FF;
}
.fav-operator {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}
.product-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.product-item {
  background: #F5F7FA;
  border: 2rpx solid #E8E8E8;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
}
.product-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}
.product-price {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #0066FF;
}
