<view class="container">
  <!-- 手机号输入 -->
  <view class="card">
    <view class="input-label">充值号码</view>
    <view class="phone-input">
      <text class="prefix">+880</text>
      <input type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <!-- 常用号码 -->
    <view class="favorites" wx:if="{{favorites.length > 0}}">
      <text class="fav-label">常用号码：</text>
      <view class="fav-list">
        <view class="fav-item" wx:for="{{favorites}}" wx:key="phone" bindtap="useFavorite" data-phone="{{item.phone}}">
          <text>{{item.phone}}</text>
          <text class="fav-operator">{{item.operator}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 商品网格 -->
  <view class="card">
    <view class="section-title">选择充值金额</view>
    <view class="product-grid">
      <view class="product-item" wx:for="{{products}}" wx:key="id" bindtap="selectProduct" data-product="{{item}}">
        <text class="product-name">{{item.name}}</text>
        <text class="product-price">৳{{item.price}}</text>
      </view>
    </view>
  </view>
</view>
