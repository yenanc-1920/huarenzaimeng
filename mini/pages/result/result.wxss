.result-container { text-align: center; padding-top: 80rpx; }
.result-card { padding: 60rpx 24rpx; }
.result-icon { font-size: 96rpx; margin-bottom: 32rpx; }
.success-icon { color: #52C41A; }
.pending-icon { color: #FAAD14; }
.failed-icon { color: #FF4D4F; }
.result-title { font-size: 36rpx; font-weight: bold; margin-bottom: 16rpx; }
.result-desc { font-size: 28rpx; color: #666; }
.result-actions { margin-top: 60rpx; display: flex; flex-direction: column; gap: 24rpx; }
.btn-secondary { background: #F5F5F5; color: #333; border: none; border-radius: 12rpx; padding: 24rpx 0; font-size: 32rpx; }
