.user-card { text-align: center; padding: 48rpx 24rpx; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: #E8E8E8; margin: 0 auto; display: flex; align-items: center; justify-content: center; }
.avatar-text { font-size: 28rpx; color: #999; }
.avatar-img { width: 120rpx; height: 120rpx; border-radius: 50%; margin: 0 auto; display: block; }
.nickname { display: block; margin-top: 16rpx; font-size: 32rpx; font-weight: bold; }
.menu-list { padding: 0; }
.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 32rpx 24rpx; border-bottom: 1rpx solid #F0F0F0; }
.menu-item:last-child { border-bottom: none; }
.menu-name { font-size: 30rpx; color: #333; }
.menu-arrow { font-size: 28rpx; color: #CCC; }