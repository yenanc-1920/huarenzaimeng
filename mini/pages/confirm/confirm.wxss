.info-row { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #F5F5F5; }
.info-row:last-child { border-bottom: none; }
.label { font-size: 28rpx; color: #666; }
.value { font-size: 28rpx; color: #333; font-weight: 500; }
.value.price { color: #FF4D4F; font-size: 36rpx; font-weight: bold; }
.mnp-status { text-align: center; padding: 20rpx; }
.checking { display: flex; align-items: center; justify-content: center; gap: 16rpx; color: #FAAD14; }
.success { display: flex; align-items: center; justify-content: center; gap: 16rpx; color: #52C41A; }
.status-icon { font-size: 36rpx; }
.status-icon.ok { color: #52C41A; }
.pay-btn { margin-top: 48rpx; }
.tip { text-align: center; font-size: 24rpx; color: #999; margin-top: 24rpx; }
