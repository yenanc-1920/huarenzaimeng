<view class="container">
  <!-- 充值信息 -->
  <view class="card">
    <view class="info-row">
      <text class="label">充值号码</text>
      <text class="value">+880 {{phone}}</text>
    </view>
    <view class="info-row">
      <text class="label">运营商</text>
      <text class="value">{{operator}}</text>
    </view>
    <view class="info-row">
      <text class="label">充值金额</text>
      <text class="value price">৳{{price}}</text>
    </view>
    <view class="info-row">
      <text class="label">折合人民币</text>
      <text class="value">¥{{cnyPrice}}</text>
    </view>
  </view>

  <!-- MNP校验状态 -->
  <view class="card" wx:if="{{mnpStatus}}">
    <view class="mnp-status">
      <view class="checking" wx:if="{{mnpStatus === 'checking'}}">
        <text class="status-icon">...</text>
        <text>号码校验中，请稍候</text>
      </view>
      <view class="success" wx:if="{{mnpStatus === 'success'}}">
        <text class="status-icon ok">✓</text>
        <text>号码校验通过</text>
      </view>
    </view>
  </view>

  <!-- 确认按钮 -->
  <button class="btn-primary pay-btn" bindtap="confirmPay" disabled="{{mnpStatus === 'checking'}}">
    确认支付 ৳{{price}}
  </button>

  <view class="tip">支付即表示同意《服务协议》</view>
</view>
