<view class="container">
  <view class="card">
    <view class="info-row">
      <text class="label">充值号码</text>
      <text class="value">+880 {{phone}}</text>
    </view>
    <view class="info-row">
      <text class="label">运营商</text>
      <text class="value">{{operator}}</text>
    </view>
    <view class="info-row">
      <text class="label">充值金额</text>
      <text class="value price">{{price}} Taka</text>
    </view>
    <view class="info-row">
      <text class="label">折合人民币</text>
      <text class="value">{{cnyPrice}} CNY</text>
    </view>
  </view>
  <view class="card" wx:if="{{mnpStatus}}">
    <view class="mnp-status">
      <view class="checking" wx:if="{{mnpStatus === 'checking'}}">
        <text class="status-icon">...</text>
        <text>号码校验中，请稍候</text>
      </view>
      <view class="success" wx:if="{{mnpStatus === 'success'}}">
        <text class="status-icon ok">OK</text>
        <text>号码校验通过</text>
      </view>
    </view>
  </view>
  <button class="btn-primary pay-btn" bindtap="confirmPay" disabled="{{mnpStatus === 'checking'}}">确认支付 {{price}} Taka</button>
  <view class="tip">支付即表示同意服务协议</view>
</view>